    <groupId>com.example</groupId>
    <artifactId>SpringBoot-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SpringBoot-demo</name>
    <description>SpringBoot-demo</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
